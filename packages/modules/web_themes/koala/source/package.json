{
  "name": "openwb-koala-web-theme",
  "version": "0.0.1",
  "description": "Koala web theme for openWB software2",
  "productName": "openWB",
  "author": "openWB <info@openwb.de>",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "lint": "eslint --ext .js,.ts,.vue ./",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test:unit": "vitest run --root src/",
    "build": "quasar build -m pwa"
  },
  "dependencies": {
    "@quasar/extras": "^1.18.0",
    "chart.js": "^4.5.1",
    "chartjs-adapter-luxon": "^1.3.1",
    "chartjs-chart-sankey": "^0.15.0",
    "chartjs-plugin-annotation": "^3.1.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "luxon": "^3.7.2",
    "mqtt": "^5.15.2",
    "pinia": "^3.0.4",
    "quasar": "^2.24.0",
    "register-service-worker": "^1.7.2",
    "vue": "^3.5.41",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@quasar/app-vite": "^2.6.2",
    "@types/node": "^25.9.5",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vite-plugin-checker": "^0.10.3",
    "vite-plugin-remove-console": "^2.2.0",
    "vite-svg-loader": "^5.1.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9",
    "workbox-build": "^7.4.1",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "engines": {
    "node": "^24 || ^22 || ^20",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "@parcel/watcher@2.6.0": true
  }
}
