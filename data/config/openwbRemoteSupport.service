# openwb-version:4
[Unit]
Description="Remote Support Handler openWB 2.0"
After=mosquitto_local.service

[Service]
User=openwb
WorkingDirectory=/var/www/html/openWB
ExecStart=/bin/bash /var/www/html/openWB/runs/run_python.sh /var/www/html/openWB/runs/remoteSupport/remoteSupport.py
Restart=always

[Install]
WantedBy=multi-user.target
