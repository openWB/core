# openwb-version:6
[Unit]
Description="Regelung openWB 2.0"
# Order startup after the time/network services without enabling disabled services.
After=mosquitto_local.service NetworkManager.service systemd-timesyncd.service

[Service]
User=openwb
WorkingDirectory=/var/www/html/openWB
ExecStartPre=-/var/www/html/openWB/runs/atreboot.sh
ExecStart=/bin/bash /var/www/html/openWB/runs/run_python.sh /var/www/html/openWB/packages/main.py
Restart=always
# extend timeout to 15min for long running atreboot
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
